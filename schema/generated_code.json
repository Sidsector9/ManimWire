{
  "$defs": {
    "Issue": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node"
        },
        "port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "SourceMap": {
      "description": "1-based line numbers of the generated code, by node id and by step index.",
      "properties": {
        "nodes": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "default": {},
          "title": "Nodes",
          "type": "object"
        },
        "steps": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "default": {},
          "title": "Steps",
          "type": "object"
        },
        "variables": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Variables",
          "type": "object"
        }
      },
      "title": "SourceMap",
      "type": "object"
    }
  },
  "description": "Code is empty when the scene has issues; the UI shows the issues instead.",
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "source_map": {
      "$ref": "#/$defs/SourceMap"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "code",
    "source_map"
  ],
  "title": "GeneratedCode",
  "type": "object"
}
