                "remove": "#/$defs/RemoveStep",
                "section": "#/$defs/SectionStep",
                "sound": "#/$defs/SoundStep",
                "subcaption": "#/$defs/SubcaptionStep",
                "updating": "#/$defs/UpdatingStep",
                "wait": "#/$defs/WaitStep"
