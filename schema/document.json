              {
                "$ref": "#/$defs/AddStep"
              },
              {
                "$ref": "#/$defs/RemoveStep"
              },
              {
                "$ref": "#/$defs/BringToFrontStep"
              },
              {
                "$ref": "#/$defs/BringToBackStep"
              },
              {
                "$ref": "#/$defs/SectionStep"
              },
              {
                "$ref": "#/$defs/SoundStep"
              },
              {
                "$ref": "#/$defs/SubcaptionStep"
              },
              {
                "$ref": "#/$defs/UpdatingStep"
              },
              {
                "$ref": "#/$defs/CameraStep"
              },
              {
                "$ref": "#/$defs/FixedInFrameStep"
              }
