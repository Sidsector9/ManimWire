{
  "name": "manim-node-workflow",
  "version": "0.0.0",
  "private": true,
  "description": "Visual programming environment for Manim Community Edition",
  "main": "./out/main/index.js",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "json2ts --cwd ../schema -i '../schema/*.json' -o src/shared/generated --bannerComment '/* Generated from ../schema by pnpm generate. Do not edit. */'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "and": "^0.0.3",
    "dev": "^0.1.5",
    "pnpm": "^12.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vscode-jsonrpc": "^9.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
